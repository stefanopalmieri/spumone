# i3status config — Spacemacs dark theme
# Colors from the Spacemacs theme (https://github.com/nashamri/spacemacs-theme)

general {
    output_format = "i3bar"
    colors = true
    interval = 5
    # Spacemacs palette
    color_good = "#2d9574"      # str / aqua (green-teal)
    color_degraded = "#b1951d"   # yellow / gold
    color_bad = "#f2241f"        # red / err
    color_separator = "#5d4d7a"  # act2 purple
    separator = "  "
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = "󰤨 (%quality at %essid) %ip"
    format_down = "󰤮 down"
}

ethernet _first_ {
    format_up = "󰈀 %ip (%speed)"
    format_down = "󰈀 down"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = "󰂄"
    status_bat = "󰁺"
    status_unk = "? "
    status_full = "󰁹 "
    low_threshold = 15
    threshold_type = percentage
    integer_battery_capacity = true
}

cpu_usage {
    format = "󰻠 %usage"
    max_threshold = 75
    degraded_threshold = 50
}

memory {
    format = " %used / %total"
    threshold_degraded = "1G"
    threshold_critical = "200M"
    format_degraded = "MEMORY < %available"
}

tztime local {
    format = "󰥔 %Y-%m-%d %H:%M:%S"
}
